# Copy this file to `.env` and fill in secrets locally. Do not commit `.env`.

OPENAI_API_KEY=
TRUSTME_OPENAI_MODEL=openai:gpt-5.2
TRUSTME_SEED_DEMO_DATA=true
TRUSTME_SQLITE_PATH=backend/trustme.sqlite3
TRUSTME_PORT=8000

RALIO_MODE=mock
RALIO_API_URL=https://api.ralio.co

# Required only for RALIO_MODE=live. Register this host with:
# ralio auth agent --ticket ralio-reg-...
RALIO_AGENT_ID=
RALIO_REGISTRATION_TICKET=

CLI_AGENT_ALLOWED_COMMANDS=ralio
